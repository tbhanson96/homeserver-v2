{
  "name": "homeserver-server",
  "version": "0.0.1",
  "description": "",
  "author": "Tim Hanson",
  "license": "MIT",
  "scripts": {
    "build": "rimraf dist tsconfig.build.tsbuildinfo && nest build && npm run swagger",
    "swagger": "ts-node swagger-doc-gen.ts",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:watch": "nest start -w",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/microservices": "11.2.7",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "12.0.3",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.7",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "epub": "2.1.1",
    "flat": "6.0.1",
    "http-proxy-middleware": "3.0.7",
    "jsonfile": "6.2.1",
    "libgen": "2.2.0",
    "memfs": "4.80.0",
    "morgan": "1.12.1",
    "ncp": "2.0.0",
    "node-calibre": "2.1.1",
    "nodemailer": "10.1.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "tar": "7.5.22",
    "typeorm": "0.3.31",
    "zip-lib": "1.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@tsconfig/node24": "24.0.5",
    "@types/express": "5.0.6",
    "@types/flat": "5.0.5",
    "@types/http-proxy": "1.17.17",
    "@types/jest": "30.0.0",
    "@types/jsonfile": "6.1.4",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "mkdirp": "3.0.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslint": "5.20.1",
    "typescript": "6.0.3",
    "webpack": "5.112.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "test",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!flat/|epub/)"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
