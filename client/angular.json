{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "homeserver-client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/",
              "browser": ""
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "sourceMap": true,
            "aot": false,
            "optimization": false,
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/apple-touch-icon.png",
              "src/apple-touch-icon-precomposed.png",
              "src/manifest.webmanifest",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss",
              {
                "input": "node_modules/@angular/material/prebuilt-themes/pink-bluegrey.css",
                "bundleName": "dark",
                "inject": false
              },
              {
                "input": "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                "bundleName": "light",
                "inject": false
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules"
              ]
            },
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              },
              "outputHashing": "all",
              "outputPath": {
                "base": "dist/",
                "browser": ""
              },
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "testing": {
              "extractLicenses": false,
              "styles": [
                "./node_modules/@angular/material/prebuilt-themes/pink-bluegrey.css",
                "src/styles.scss"
              ],
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "homeserver-client:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "homeserver-client:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "browserTarget": "homeserver-client:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "reporters": [
              "default"
            ],
            "coverageReporters": [
              "html",
              "lcovonly",
              "text-summary"
            ],
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        }
      }
    }},
  "cli": {
    "analytics": false
  }
}
